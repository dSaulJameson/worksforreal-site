execution.associates {
    import security
    encode zstd gzip
    reverse_proxy 127.0.0.1:3015
}

www.execution.associates, executionassociates.com, www.executionassociates.com {
    import security
    redir https://execution.associates{uri} permanent
}

app.execution.associates {
    import security
    header X-Robots-Tag "noindex, nofollow, noarchive"
    header >Referrer-Policy "no-referrer"
    request_body {
        max_size 30MB
    }
    reverse_proxy 127.0.0.1:3022 {
        header_up X-Real-IP {remote_host}
        header_up Host app.execution.associates
    }
}
